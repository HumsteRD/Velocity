root = true

[*.cs]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

[*.{xaml,json,md,iss}]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
