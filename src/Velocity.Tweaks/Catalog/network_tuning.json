[
  {
    "Id": "net.qos_games",
    "Category": "Network",
    "Title": "Приоритет игрового трафика (QoS, DSCP 46)",
    "Description": "Windows начинает помечать исходящие пакеты игры меткой DSCP 46 — «срочный трафик», как у голосовой связи. Сама метка ничего не ускоряет: она работает там, где устройство на пути её учитывает. Wi-Fi с WMM (это почти любой роутер) отправляет такие пакеты в приоритетную очередь, роутеры с QoS или SQM — тоже. Провайдер метку обычно сбрасывает, поэтому выигрыш есть на участке «компьютер — роутер». Но именно там, особенно на Wi-Fi, и возникает очередь, когда кто-то дома смотрит видео или качает.\n\nПолитики создаются для CS2, Valorant, Fortnite и Apex Legends. На домашнем компьютере вне домена Windows игнорирует политики QoS без служебного параметра «Do not use NLA» — он ставится вместе с ними и убирается при откате.",
    "Effect": "Политики QoS с DSCP 46 для cs2.exe, VALORANT-Win64-Shipping.exe, FortniteClient-Win64-Shipping.exe, r5apex.exe, r5apex_dx12.exe",
    "ExpectedGain": "Меньше пинг и потери, когда домашняя сеть загружена. На свободной сети — без изменений",
    "Risk": "Safe",
    "Confidence": "Documented",
    "RequiresReboot": true,
    "RequiresElevation": true,
    "DetectAll": true,
    "Presets": [
      "Competitive",
      "Maximum",
      "Extreme"
    ],
    "Apply": [
      {
        "type": "registry",
        "Hive": "HKLM",
        "Path": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\QoS",
        "Name": "Do not use NLA",
        "Kind": "string",
        "Value": "1"
      },
