<UserControl x:Class="Velocity.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="Transparent">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoRow">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource TextMuted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TextValue}"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- Кружок акцента: цвет берётся из Background, выбранный обведён кольцом, как в FI -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Width="34" Height="34" StrokeThickness="2"
                                     Stroke="{StaticResource TextPrimary}" Visibility="Collapsed"/>
                            <Ellipse Width="26" Height="26" Fill="{TemplateBinding Background}"
                                     Stroke="{StaticResource BorderStrong}" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="{app:T 'Настройки'}" Style="{StaticResource TextTitle}"/>
            <TextBlock Text="{app:T 'Оформление, окно и язык, обновления, данные программы'}" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- ─────────── Оформление ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel Margin="0,0,260,0">
                                <TextBlock Text="{app:T 'Оформление'}" Style="{StaticResource TextLabel}"/>
                                <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{app:T 'Тема, акцент, шрифт, углы и масштаб.'}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="FromFiButton" Content="{app:T 'Взять из FI'}" Style="{StaticResource ButtonCompact}"
                                        Click="FromFi_Click" Margin="0,0,6,0"/>
                                <Button Content="{app:T 'Сбросить'}" Style="{StaticResource ButtonGhost}" Click="ResetLook_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{app:T 'Тема'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <ItemsControl x:Name="ThemeList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="LookTheme" Tag="{Binding Id}" IsChecked="{Binding IsCurrent, Mode=OneTime}"
                                                 AutomationProperties.Name="{Binding Name}" Checked="Theme_Checked"
                                                 Cursor="Hand" Margin="0,0,8,8">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Frame" Width="104" Padding="5" BorderThickness="2"
                                                        BorderBrush="Transparent" Background="{StaticResource BgInset}"
                                                        CornerRadius="{StaticResource RadiusMd}">
                                                    <StackPanel>
                                                        <!-- Миниатюра как в FI: фон темы, полоса панели и капля акцента -->
                                                        <Border Height="52" Background="{Binding PreviewBg}" CornerRadius="5"
                                                                BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <Border Height="15" VerticalAlignment="Bottom" Margin="6,0,6,6"
                                                                        CornerRadius="4" Background="{Binding PreviewPanel}"/>
                                                                <Border Width="14" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Margin="0,0,11,10" CornerRadius="4" Background="{Binding PreviewAccent}"/>
                                                                <Border Width="26" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                        Margin="8,9,0,0" CornerRadius="2" Background="{Binding PreviewText}"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextBase}" FontSize="{StaticResource FontSm}"
                                                                   Margin="2,6,0,1"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{app:T 'Акцент'}" Style="{StaticResource TextSection}" Margin="0,10,0,8"/>
                        <WrapPanel x:Name="AccentPanel" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="CustomAccent" Width="120" Style="{StaticResource Input}"
                                     MaxLength="7" ToolTip="{app:T 'Свой цвет в формате #RRGGBB'}"/>
                            <Button Content="{app:T 'Свой цвет'}" Style="{StaticResource ButtonCompact}" Margin="8,0,0,0"
                                    Click="CustomAccent_Click"/>
                        </StackPanel>

                        <TextBlock Text="{app:T 'Шрифт'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <WrapPanel x:Name="FontPanel"/>

                        <TextBlock Text="{app:T 'Углы'}" Style="{StaticResource TextSection}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource SegmentBar}"><StackPanel x:Name="RadiusPanel" Orientation="Horizontal"/></Border>

                        <TextBlock Text="{app:T 'Масштаб'}" Style="{StaticResource TextSection}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left"><StackPanel x:Name="ScalePanel" Orientation="Horizontal"/></Border>

                        <TextBlock Text="{app:T 'Кнопки'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <TextBlock Text="{app:T 'Стиль и цвет главных кнопок. По умолчанию — заливка цветом акцента.'}" Style="{StaticResource TextMuted}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left"><StackPanel x:Name="ButtonStylePanel" Orientation="Horizontal"/></Border>
                        <WrapPanel x:Name="ButtonColorPanel" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="CustomButtonColor" Width="120" Style="{StaticResource Input}" MaxLength="7" ToolTip="{app:T 'Свой цвет в формате #RRGGBB'}"/>
                            <Button Content="{app:T 'Свой цвет'}" Style="{StaticResource ButtonCompact}" Margin="8,0,0,0" Click="CustomButtonColor_Click"/>
                        </StackPanel>
                        <TextBlock Text="{app:T 'Фон'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <TextBlock Text="{app:T 'Свой цвет фона: панели, линии и текст подстраиваются под него автоматически.'}" Style="{StaticResource TextMuted}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="BackgroundPanel" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="CustomBackground" Width="120" Style="{StaticResource Input}" MaxLength="7" ToolTip="{app:T 'Свой цвет в формате #RRGGBB'}"/>
                            <Button Content="{app:T 'Свой цвет'}" Style="{StaticResource ButtonCompact}" Margin="8,0,0,0" Click="CustomBackground_Click"/>
                        </StackPanel>
                        <TextBlock Text="{app:T 'Анимация фона'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <WrapPanel x:Name="AnimPanel"/>
                        <TextBlock Text="{app:T 'Эффект нажатия'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left"><StackPanel x:Name="ClickPanel" Orientation="Horizontal"/></Border>
                        <TextBlock Text="{app:T 'Тени карточек'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left"><StackPanel x:Name="ShadowPanel" Orientation="Horizontal"/></Border>
                        <TextBlock Text="{app:T 'Прозрачность карточек'}" Style="{StaticResource TextSection}" Margin="0,16,0,8"/>
                        <TextBlock Text="{app:T 'Сквозь карточки виден фон темы и его анимация.'}" Style="{StaticResource TextMuted}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left"><StackPanel x:Name="CardPanel" Orientation="Horizontal"/></Border>

                        <Grid Margin="0,16,0,0">
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="{app:T 'Анимации'}" Style="{StaticResource TextSection}"/>
                                <TextBlock Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="{app:T 'Появление экранов, живой фон и эффекты нажатия. На слабом ПК можно выключить.'}"/>
                            </StackPanel>
                            <CheckBox x:Name="MotionToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="{app:T 'Анимации'}" Click="Motion_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─────────── Окно и язык ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Окно и язык'}" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Язык интерфейса'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'После смены программа перезапустится.'}" Style="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Top">
                                <StackPanel x:Name="LanguagePanel" Orientation="Horizontal"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Прозрачность окна'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'Сквозь фон окна виден рабочий стол. Карточки остаются непрозрачными, чтобы текст читался.'}"
                                           Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Top">
                                <StackPanel x:Name="TransparencyPanel" Orientation="Horizontal"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Размытие под окном'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'Рабочий стол за прозрачным окном размывается, как в «Параметрах» Windows.'}" Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="BlurToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                      Margin="0,3,0,0" AutomationProperties.Name="{app:T 'Размытие под окном'}" Click="Blur_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Поверх всех окон'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'Окно не прячется за другими — удобно держать рядом с игрой в оконном режиме.'}" Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="TopmostToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                      Margin="0,3,0,0" AutomationProperties.Name="{app:T 'Поверх всех окон'}" Click="Topmost_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Запускать вместе с Windows'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'Программа стартует свёрнутой в трей и ничего не меняет сама.'}" Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                      Margin="0,3,0,0" AutomationProperties.Name="{app:T 'Запускать вместе с Windows'}" Click="Autostart_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Сворачивать в трей при закрытии'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Text="{app:T 'Крестик убирает окно к часам. Выход — правой кнопкой по значку.'}" Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                      Margin="0,3,0,0" AutomationProperties.Name="{app:T 'Сворачивать в трей при закрытии'}" Click="Tray_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─────────── Обновления ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Обновления'}" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Проверять обновления при запуске'}"
                                           Style="{StaticResource TextBase}"/>
                                <TextBlock Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="{app:T 'Раз в сутки через GitHub. Ничего не отправляется.'}"/>
                            </StackPanel>
                            <CheckBox x:Name="CheckUpdatesToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{app:T 'Скачивать обновление сразу'}" Style="{StaticResource TextBase}"/>
                                <TextBlock Style="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="{app:T 'Загрузка в фоне, установка — только с твоего согласия.'}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoDownloadToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VersionLine" Style="{StaticResource TextBase}"/>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource TextMuted}" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CheckNowButton" Content="{app:T 'Проверить сейчас'}"
                                    Style="{StaticResource ButtonSecondary}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CheckNow_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─────────── Программа ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Программа'}" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="AboutList" ItemTemplate="{StaticResource InfoRow}"/>
                    </StackPanel>
                </Border>

                <!-- ─────────── Данные ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Данные'}" Style="{StaticResource TextLabel}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="DataList" ItemTemplate="{StaticResource InfoRow}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{app:T 'Открыть папку данных'}" Style="{StaticResource ButtonSecondary}"
                                    Click="OpenDataFolder_Click"/>
                            <Button Content="{app:T 'Сохранить отчёт о системе'}" Style="{StaticResource ButtonSecondary}"
                                    Margin="8,0,0,0" Click="ExportReport_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─────────── Каталог ─────────── -->
                <Border Style="{StaticResource GroupPanel}" Padding="20,18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Загруженный каталог'}" Style="{StaticResource TextLabel}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CatalogList" ItemTemplate="{StaticResource InfoRow}"/>
                        <ItemsControl x:Name="ErrorList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TextMuted}"
                                               Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
