<UserControl x:Class="Velocity.App.Views.FpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="{app:T 'FPS в игре'}" Style="{StaticResource TextTitle}"/>
            <TextBlock Style="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                       Text="{app:T 'Средний FPS, 1% и 0.1% low, время кадра и рывки. Замер по событиям DirectX — как у PresentMon: в игру ничего не внедряется, античиты не реагируют.'}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="28,0,20,24">
            <StackPanel>
                <!-- ─────────── Новый замер ─────────── -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{app:T 'Новый замер'}" Style="{StaticResource TextLabel}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,24,8">
                                    <TextBlock Text="{app:T 'Этап'}" Style="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SegmentBar}">
                                        <StackPanel x:Name="StagePanel" Orientation="Horizontal"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,8">
                                    <TextBlock Text="{app:T 'Длительность'}" Style="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SegmentBar}">
                                        <StackPanel x:Name="DurationPanel" Orientation="Horizontal"/>
                                    </Border>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="CaptureStatus" Style="{StaticResource TextBody}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{app:T 'Нажми «Начать», переключись в игру и играй как обычно. Через 10 секунд прозвучит сигнал — замер пошёл; второй сигнал — готово.'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button x:Name="StartButton" Content="{app:T 'Начать замер'}" Style="{StaticResource ButtonPrimary}"
                                    MinWidth="170" Click="Start_Click"/>
                            <Button Content="{app:T 'Импорт CSV'}" Style="{StaticResource ButtonSecondary}" Margin="0,8,0,0"
                                    ToolTip="{app:T 'PresentMon или CapFrameX: столбец MsBetweenPresents'}" Click="Import_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AdminNote" Style="{StaticResource Card}" Padding="20,14" Margin="0,10,0,0"
                        BorderBrush="{StaticResource AccentLine}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Text="{app:T 'Замер читает события DirectX через трассировку Windows (ETW) — для этого Windows требует права администратора.'}"/>
                        <Button Grid.Column="1" Content="{app:T 'Перезапустить от администратора'}" Style="{StaticResource ButtonCompact}"
                                VerticalAlignment="Center" Click="Elevate_Click"/>
                    </Grid>
                </Border>

                <!-- ─────────── Результаты ─────────── -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{app:T 'Замеры'}" Style="{StaticResource TextLabel}" Margin="10,8,0,8"/>
                            <ListBox x:Name="RunList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource SelectorItem}"
                                     SelectionChanged="RunList_SelectionChanged" MaxHeight="520">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Game}" Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Fps}" Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyRuns" Style="{StaticResource TextMuted}" Margin="10,4,10,12" TextWrapping="Wrap"
                                       Text="{app:T 'Замеров пока нет. Сделай первый до оптимизации — он станет точкой «до».'}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" x:Name="DetailPanel" Visibility="Collapsed" SizeChanged="DetailPanel_SizeChanged">
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="DetailTitle" Style="{StaticResource TextBase}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DetailMeta" Style="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="{app:T 'Удалить'}" Style="{StaticResource ButtonGhost}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Click="Delete_Click"/>
                            </Grid>
                        </Border>

                        <UniformGrid x:Name="MetricTiles" Columns="5" Margin="0,10,0,0"/>

                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{app:T 'Время кадра'}" Style="{StaticResource TextLabel}"/>
                                    <TextBlock x:Name="ChartLegend" Style="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Canvas x:Name="Chart" Height="190" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CompareCard" Style="{StaticResource Card}" Padding="20,16" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{app:T 'До и после'}" Style="{StaticResource TextLabel}"/>
                                <Grid x:Name="CompareGrid" Margin="0,10,0,0"/>
                                <TextBlock x:Name="CompareHint" Style="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Как мерить честно'}" Style="{StaticResource TextLabel}"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                                   Text="{app:T '1. Одна и та же сцена: тренировка, повтор или встроенный бенчмарк. Матч с живыми игроками каждый раз разный.&#x0a;2. Те же настройки графики и разрешение до и после.&#x0a;3. Два-три прогона подряд: разница между ними — это погрешность.&#x0a;4. Важнее всего 1% low и рывки: именно они ощущаются как лаги, а не средний FPS.&#x0a;5. Vulkan и OpenGL этим замером не видны — запиши их в PresentMon и импортируй CSV.'}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
