<UserControl x:Class="Velocity.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent">
    <UserControl.Resources>
        <app:SeverityBrushConverter x:Key="SeverityBrush"/>
        <app:SeverityLabelConverter x:Key="SeverityLabel"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
        <DataTemplate x:Key="SpecRow">
            <Grid Margin="0,0,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource TextMuted}"/>
                <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource TextBase}"
                           Margin="0,3,0,0" FontSize="{StaticResource FontSm}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,28,32,22">
            <StackPanel>
                <TextBlock Text="{app:T 'Обзор системы'}" Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,5,0,0"
                           Text="{app:T 'Сканирование…'}"/>
            </StackPanel>
            <Button x:Name="RescanButton" Style="{StaticResource ButtonCompact}"
                    Content="{app:T 'Пересканировать'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Rescan_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}" Padding="32,0,24,30">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
                <Border Style="{StaticResource GroupPanel}">
                    <Grid x:Name="HeroGrid" SizeChanged="Hero_SizeChanged">
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{app:T 'Готовность системы'}" Style="{StaticResource TextLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="ScoreValue" Text="—" Style="{StaticResource TextMetric}"
                                           FontSize="{StaticResource Font3xl}" FontWeight="SemiBold"/>
                                <TextBlock Text="/100" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                            </StackPanel>
                            <TextBlock x:Name="ScoreLabel" Text="" Style="{StaticResource TextSection}"
                                       Margin="0,2,0,0" Foreground="{StaticResource AccentInk}"/>
                            <Border Height="4" Background="{StaticResource BgInset}" CornerRadius="2"
                                    Margin="0,12,0,0">
                                <Border x:Name="ScoreBar" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource Accent}" CornerRadius="2"/>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource BorderSubtle}" Margin="24,0"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{app:T 'Сейчас'}" Style="{StaticResource TextLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <StackPanel Width="150">
                                    <TextBlock x:Name="ProblemCount" Text="—" Style="{StaticResource TextMetric}"
                                               FontSize="{StaticResource FontXl}"/>
                                    <TextBlock Text="{app:T 'требуют внимания'}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Width="150">
                                    <TextBlock x:Name="FixableCount" Text="—" Style="{StaticResource TextMetric}"
                                               FontSize="{StaticResource FontXl}" Foreground="{StaticResource AccentInk}"/>
                                    <TextBlock Text="{app:T 'можно исправить'}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GameCount" Text="—" Style="{StaticResource TextMetric}"
                                               FontSize="{StaticResource FontXl}"/>
                                    <TextBlock Text="{app:T 'игр найдено'}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button Content="{app:T 'К оптимизациям →'}" Style="{StaticResource ButtonLink}"
                                        Tag="Optimize" Click="OpenSection_Click"/>
                                <Button Content="{app:T 'Приватность и фон →'}" Style="{StaticResource ButtonLink}"
                                        Margin="22,0,0,0" Tag="Privacy" Click="OpenSection_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>

                <TextBlock Text="{app:T 'Конфигурация'}" Style="{StaticResource TextLabel}" Margin="2,28,0,9"/>
                <Border Style="{StaticResource GroupPanel}" Padding="24,20,2,8">
                    <ItemsControl x:Name="SpecList" ItemTemplate="{StaticResource SpecRow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <TextBlock x:Name="FindingsHeader" Text="{app:T 'Требует внимания'}"
                           Style="{StaticResource TextLabel}" Margin="2,28,0,9"/>
                <Border x:Name="FindingsPanel" Style="{StaticResource GroupPanel}">
                    <ItemsControl x:Name="FindingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                                   VerticalAlignment="Stretch" Margin="-24,-18,0,-18"
                                                   Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="17,0,0,0">
                                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource BadgeDot}"
                                                             Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}"
                                                               Style="{StaticResource BadgeText}"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                                       FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource TextBody}"
                                                       Margin="0,6,0,0" FontSize="{StaticResource FontSm}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                        Visibility="{Binding Recommendation, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="→" Foreground="{StaticResource AccentInk}" Style="{StaticResource TextBase}"/>
                                                <TextBlock Text="{Binding Recommendation}" Margin="8,0,0,0"
                                                           Style="{StaticResource TextBase}" FontSize="{StaticResource FontSm}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource TextMuted}"
                                                       Margin="18,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding ExpectedGain, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{app:T 'Исправить'}" Style="{StaticResource ButtonCompact}"
                                                VerticalAlignment="Top" Margin="18,0,0,0" Tag="{Binding FixTweakId}"
                                                Click="Fix_Click" Visibility="{Binding FixTweakId, Converter={StaticResource NullToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border x:Name="CleanState" Style="{StaticResource GroupPanel}" Padding="24,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{app:T 'Критичных проблем не найдено'}" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                        <TextBlock Text="{app:T 'Проверь «Оптимизацию», если хочешь настроить систему под игры.'}"
                                   Style="{StaticResource TextBody}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
