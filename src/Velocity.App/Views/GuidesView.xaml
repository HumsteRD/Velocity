<UserControl x:Class="Velocity.App.Views.GuidesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Velocity.App"
             Background="Transparent">

    <UserControl.Resources>
        <app:RiskBrushConverter x:Key="RiskBrush"/>
        <app:NullToVisibilityConverter x:Key="NullToVis"/>
        <app:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <app:CountToVisibilityConverter x:Key="CountToVis"/>

        <Style x:Key="BlockLabel" TargetType="TextBlock" BasedOn="{StaticResource TextLabel}">
            <Setter Property="Margin" Value="0,18,0,7"/>
        </Style>

        <!-- Маркированный список строк -->
        <DataTemplate x:Key="Bullet">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource Accent}"
                        VerticalAlignment="Top" Margin="2,7,10,0"/>
                <TextBlock Grid.Column="1" app:GuideText.Rich="{Binding}" Style="{StaticResource TextBody}"
                           FontSize="{StaticResource FontSm}" TextWrapping="Wrap" LineHeight="21"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="{app:T 'Руководства'}" Style="{StaticResource TextTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{app:T 'BIOS, установка Windows, роутер и проверка сторонними утилитами. Отметки шагов сохраняются.'}"/>
            <Border Style="{StaticResource SegmentBar}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="Section" Tag="All"
                             Content="{app:T 'Все'}" IsChecked="True" Checked="Section_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="Section" Tag="Windows"
                             Content="Windows" Checked="Section_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="Section" Tag="Bios"
                             Content="{app:T 'BIOS и железо'}" Checked="Section_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="Section" Tag="Network"
                             Content="{app:T 'Сеть и роутер'}" Checked="Section_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="Section" Tag="Diagnostics"
                             Content="{app:T 'Диагностика'}" Checked="Section_Checked"/>
            </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── Список ─────────── -->
            <Border Grid.Column="0" Style="{StaticResource GroupPanel}" Padding="6">
                <ListBox x:Name="GuideList" Style="{StaticResource CleanListBox}"
                         ItemContainerStyle="{StaticResource SelectorItem}"
                         SelectionChanged="GuideList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}" Margin="12,12,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}"
                                               FontSize="{StaticResource FontSm}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource TextMuted}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right" Fill="{Binding ListDotBrush}"/>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource TextMuted}"
                                               FontSize="{StaticResource FontXs}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ─────────── Карточка руководства ─────────── -->
            <ScrollViewer x:Name="DetailScroll" Grid.Column="2" Style="{StaticResource CleanScrollViewer}" Padding="0,0,8,0">
                <StackPanel x:Name="DetailHost" MaxWidth="900" HorizontalAlignment="Left">

                    <Border Style="{StaticResource GroupPanel}" Padding="22,19">
                        <StackPanel>
                            <TextBlock Text="{Binding SectionName}" Style="{StaticResource TextLabel}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="19" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBody}" Margin="0,5,0,0" TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,14,0,0">
                                <Border Background="{StaticResource BgInset}" CornerRadius="{StaticResource RadiusSm}"
                                        Padding="9,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Fill="{Binding Risk, Converter={StaticResource RiskBrush}}"/>
                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgInset}" CornerRadius="{StaticResource RadiusSm}"
                                        Padding="9,5" Margin="0,0,8,0"
                                        Visibility="{Binding Duration, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Duration}" Style="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Что программа знает сама -->
                            <Border Background="{StaticResource BgInset}" CornerRadius="{StaticResource RadiusSm}"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                    Padding="12,10" Margin="0,14,0,0"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource TextBase}" FontSize="{StaticResource FontSm}" FontWeight="SemiBold">
                                            <Run Text="{app:T 'Сейчас — '}"/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusVerdict}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"
                                                   Foreground="{Binding StatusBrush}"
                                                   Visibility="{Binding StatusVerdict, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupPanel}" Padding="22,4,22,20" Margin="0,12,0,0">
                        <StackPanel>

                            <StackPanel Visibility="{Binding Gain, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{app:T 'Чего ждать'}" Style="{StaticResource BlockLabel}"/>
                                <TextBlock Text="{Binding Gain}" Style="{StaticResource TextBase}" FontSize="{StaticResource FontSm}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>

                            <Border Background="{StaticResource WarningDim}" CornerRadius="{StaticResource RadiusSm}"
                                    Padding="12,10" Margin="0,18,0,0"
                                    Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{app:T 'Важно'}" Style="{StaticResource TextLabel}" Foreground="{StaticResource Warning}"/>
                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}"
                                                           Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Схема к руководству: слоты, кабели, клавиши BIOS -->
                            <ContentControl x:Name="FigureHost" Focusable="False"/>

                            <!-- Шаги -->
                            <Grid Margin="0,18,0,8">
                                <TextBlock Text="{app:T 'Шаги'}" Style="{StaticResource TextLabel}"/>
                                <TextBlock Text="{Binding ProgressLong}" Style="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ChecklistItem}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                  Checked="Step_Changed" Unchecked="Step_Changed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource TextValue}"
                                                           Foreground="{StaticResource AccentInk}" Margin="0,1,0,0"/>
                                                <TextBlock Grid.Column="1" app:GuideText.Rich="{Binding Text}"
                                                           FontSize="{StaticResource FontSm}" TextWrapping="Wrap" LineHeight="21">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding Verify.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{app:T 'Как проверить'}" Style="{StaticResource BlockLabel}"/>
                                <ItemsControl ItemsSource="{Binding Verify}" ItemTemplate="{StaticResource Bullet}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Undo.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{app:T 'Как вернуть'}" Style="{StaticResource BlockLabel}"/>
                                <ItemsControl ItemsSource="{Binding Undo}" ItemTemplate="{StaticResource Bullet}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Tools.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{app:T 'Инструменты'}" Style="{StaticResource BlockLabel}"/>
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Style="{StaticResource ButtonLink}" Content="{Binding Name}"
                                                        Tag="{Binding Url}" Click="Tool_Click" ToolTip="{Binding Url}"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource TextMuted}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{app:T 'Скачивай утилиты только с официальных сайтов.'}"
                                           Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Why, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{app:T 'Почему это работает'}" Style="{StaticResource BlockLabel}"/>
                                <TextBlock Text="{Binding Why}" Style="{StaticResource TextBody}" FontSize="{StaticResource FontSm}"
                                           TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>

                            <Button Content="{app:T 'Сбросить отметки шагов'}" Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left"
                                    Margin="-10,16,0,0" Click="ResetSteps_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
