<Window x:Class="Velocity.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:Velocity.App"
        Title="VELOCITY" Height="790" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Собственная рамка окна: стандартная рамка Windows рядом с тёмным интерфейсом выглядит инородно. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootFrame" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
            Background="{StaticResource BgBase}">
        <Grid>
            <!-- ─────────── Фон темы: свечения и сетка, как body в FI ─────────── -->
            <Border Background="{StaticResource BackdropTop}" IsHitTestVisible="False"/>
            <Border Background="{StaticResource BackdropBottom}" IsHitTestVisible="False"/>
            <Border Background="{StaticResource BackdropGrid}" IsHitTestVisible="False"/>
            <!-- Живой фон темы: сияние, волны, частицы, сетка, лепестки -->
            <Canvas x:Name="DecorLayer" IsHitTestVisible="False" ClipToBounds="True"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────── Заголовок окна (.titlebar) ─────────── -->

                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- Знак в плитке, как у FI: тёмный квадрат и две скошенные полосы акцентом -->
                            <Border Width="22" Height="22" CornerRadius="5" Background="#0E0C11"
                                    BorderBrush="#1AFFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Viewbox Margin="4,5">
                                    <Canvas Width="16" Height="14">
                                        <Path Fill="{StaticResource Accent}" Data="M 0,0 L 5,0 L 9,14 L 4,14 Z"/>
                                        <Path Fill="{StaticResource Accent}" Opacity="0.45" Data="M 7,0 L 12,0 L 16,14 L 11,14 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="VELOCITY" Margin="9,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontDisplay}" FontSize="13"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border x:Name="AdminBadge" Style="{StaticResource Badge}" Margin="12,0,0,0" Height="20">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource BadgeDot}" Fill="{StaticResource AccentInk}"/>
                                    <TextBlock Text="{app:T 'Администратор'}" Style="{StaticResource BadgeText}"
                                               FontSize="{StaticResource FontXs}" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                                    VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                                    ToolTip="{app:T 'Свернуть'}"/>
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                    Content="&#xE922;" Click="Maximize_Click" ToolTip="{app:T 'Развернуть'}"/>
                            <Button Style="{StaticResource CaptionButtonClose}" Content="&#xE8BB;" Click="Close_Click"
                                    ToolTip="{app:T 'Закрыть'}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─────────── Навигация ─────────── -->

                <DockPanel Grid.Row="1" Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="20,6,20,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE713;"
                                     Content="{app:T 'Настройки'}" GroupName="Nav" Tag="Settings" Checked="Nav_Checked"/>
                    </StackPanel>

                    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Margin="0,6,0,0">
                    <StackPanel x:Name="NavPanel">
                        <TextBlock Text="{app:T 'Разбор'}" Style="{StaticResource TextLabel}" Margin="22,4,0,6"/>
                        <RadioButton x:Name="NavDiagnosis" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE9D5;"
                                     Content="{app:T 'Разбор ПК'}" GroupName="Nav" Tag="Diagnosis" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE80F;"
                                     Content="{app:T 'Обзор системы'}" GroupName="Nav" Tag="Dashboard" Checked="Nav_Checked"/>
                        <TextBlock Text="{app:T 'Исправление'}" Style="{StaticResource TextLabel}" Margin="22,14,0,6"/>
                        <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE945;"
                                     Content="{app:T 'Оптимизация'}" GroupName="Nav" Tag="Optimize" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE72E;"
                                     Content="{app:T 'Приватность и фон'}" GroupName="Nav" Tag="Privacy" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE7E8;"
                                     Content="{app:T 'Автозагрузка и фон'}" GroupName="Nav" Tag="Startup" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE839;"
                                     Content="{app:T 'Сеть'}" GroupName="Nav" Tag="Network" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE74D;"
                                     Content="{app:T 'Очистка диска'}" GroupName="Nav" Tag="Cleanup" Checked="Nav_Checked"/>
                        <TextBlock Text="{app:T 'Игры'}" Style="{StaticResource TextLabel}" Margin="22,14,0,6"/>
                        <RadioButton x:Name="NavFps" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xEC4A;"
                                     Content="{app:T 'FPS в игре'}" GroupName="Nav" Tag="Fps" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE7FC;"
                                     Content="{app:T 'Профили игр'}" GroupName="Nav" Tag="Games" Checked="Nav_Checked"/>
                        <TextBlock Text="{app:T 'Проверка и ручные шаги'}" Style="{StaticResource TextLabel}" Margin="22,14,0,6"/>
                        <RadioButton x:Name="NavBenchmark" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE9D9;"
                                     Content="{app:T 'Замеры системы'}" GroupName="Nav" Tag="Benchmark" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGuides" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE736;"
                                     Content="{app:T 'Руководства'}" GroupName="Nav" Tag="Guides" Checked="Nav_Checked"/>
                        <TextBlock Text="{app:T 'Безопасность'}" Style="{StaticResource TextLabel}" Margin="22,14,0,6"/>
                        <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" app:Nav.Glyph="&#xE81C;"
                                     Content="{app:T 'Точки отката'}" GroupName="Nav" Tag="Restore" Checked="Nav_Checked"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ─────────── Содержимое ─────────── -->

                <ContentControl x:Name="ContentHost" Grid.Row="1" Grid.Column="1" MaxWidth="1320">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!-- ─────────── Строка состояния (.footer) ─────────── -->

                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                    <Grid Margin="18,0">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                   Style="{StaticResource TextMuted}" Text="{app:T 'Готов'}"/>
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource TextMuted}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Отклик на нажатия: волна, круги на воде, вспышка. Поверх всего и не ловит мышь. -->
            <Canvas x:Name="EffectLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
